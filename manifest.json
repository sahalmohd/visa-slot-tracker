{
  "manifest_version": 3,
  "name": "Visa Slot Alert - July 2026",
  "version": "1.0.0",
  "description": "Checks checkvisaslots.com and alerts when July 2026 L-1 Individual Regular slots are open.",
  "permissions": ["alarms", "storage", "notifications"],
  "host_permissions": ["https://checkvisaslots.com/*"],
  "icons": {
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Visa Slot Alert",
    "default_icon": {
      "128": "icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
